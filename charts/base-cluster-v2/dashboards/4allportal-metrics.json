{
  "id": null,
  "uid": "4allportal-metrics",
  "title": "4ALLPORTAL Metrics",
  "description": "4ALLPORTAL backend metrics per namespace/instance. Ported from EU-2-internal; database section dropped (see the MySQL InnoDB Cluster Health dashboard).",
