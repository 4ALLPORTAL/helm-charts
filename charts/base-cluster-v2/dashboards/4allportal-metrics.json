      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": "Mimir",
        "query": {
          "qryType": 1,
          "query": "label_values(jvm_threads_states_threads{container=\"4allportal\"}, namespace)",
          "refId": "namespace"
