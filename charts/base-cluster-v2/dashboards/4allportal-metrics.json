        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "definition": "label_values(jvm_threads_states_threads{container=\"4allportal\"}, namespace)"
      },
      {
        "name": "service",
        "label": "Instance",
        "type": "query",
        "datasource": "Mimir",
        "query": {
          "qryType": 1,
          "query": "label_values(jvm_threads_states_threads{namespace=\"$namespace\"}, service)",
          "refId": "service"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "definition": "label_values(jvm_threads_states_threads{namespace=\"$namespace\"}, service)"
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": "Mimir",
        "query": {
          "qryType": 1,
          "query": "label_values(jvm_threads_states_threads{namespace=\"$namespace\", service=\"$service\"}, pod)",
          "refId": "pod"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {},
        "options": [],
        "definition": "label_values(jvm_threads_states_threads{namespace=\"$namespace\", service=\"$service\"}, pod)"
      },
      {
        "name": "pvc",
        "label": "PVC",
        "type": "query",
        "datasource": "Mimir",
        "query": {
          "qryType": 1,
          "query": "label_values(kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\"}, persistentvolumeclaim)",
          "refId": "pvc"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {},
        "options": [],
        "definition": "label_values(kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\"}, persistentvolumeclaim)"
      }
    ]
