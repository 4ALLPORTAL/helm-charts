{
  "extends": [
    "config:recommended"
  ],
  "assigneesFromCodeOwners": true,
  "assigneesSampleSize": 1,
  "dependencyDashboard": true,
  "separateMinorPatch": true,
  "prHourlyLimit": 10,
  "prConcurrentLimit": 15,
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "Pin digests only for GitHub Actions (SHA-pin every uses:); avoids arming digest pinning on the helm/chart managers",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "Auto-merge patch-level dependency updates only",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Bump the touched chart's own Chart.yaml by one patch whenever Renovate updates any dependency inside that chart's folder (covers Chart.yaml deps and base-cluster-v2's subchart versions in templates/_versions.tpl alike). additionalBranchPrefix keeps each chart dir on its own branch so a shared dep never bumps only one of several Chart.yamls.",
      "matchFileNames": [
        "charts/**"
      ],
      "additionalBranchPrefix": "{{{ replace '/' '-' packageFileDir }}}-",
      "bumpVersions": [
        {
          "name": "chart version",
          "filePatterns": [
            "{{{ replace 'charts/([^/]+).*' 'charts/$1/Chart.yaml' packageFileDir }}}"
          ],
          "matchStrings": [
            "(?m)^version:\\s+(?<version>\\S+)"
          ],
          "bumpType": "patch"
        }
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "base-cluster-v2 subchart versions pinned in templates/_versions.tpl",
      "managerFilePatterns": [
        "/^charts/base-cluster-v2/templates/_versions\\.tpl$/"
      ],
      "matchStrings": [
        "renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+packageName=(?<packageName>\\S+))?(?:\\s+registryUrl=(?<registryUrl>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?[^\\n]*\\n\\{\\{-\\s*define\\s+\"[^\"]+\"\\s*-\\}\\}(?<currentValue>[^{]+?)\\{\\{-\\s*end"
      ]
    }
  ]
}
